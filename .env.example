# Copy to .env and fill in. Never commit .env.

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080
APP_URL=http://localhost:8080

# Database (Postgres in production; local dev falls back to the framework default)
DATABASE_URL=

# Private test machines for merges (Vercel Sandbox)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Pull requests: a GitHub OAuth app with the repo scope
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# In-app assistant: any OpenAI compatible endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=
